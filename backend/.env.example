# Copy this file to .env and fill in your values.

# --- Supabase (metadata table + file storage bucket) ---
# Project URL from Project Settings -> API. SUPABASE_KEY must be the
# secret/service_role key (NOT the publishable/anon key) — this runs
# server-side only and bypasses row level security, so keep it out of
# any frontend code. Run backend/supabase_schema.sql once in the
# Supabase SQL Editor before starting the app, and create a Storage
# bucket matching SUPABASE_BUCKET (private is fine).
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=reports

# --- AI provider (required for the chatbot to actually answer questions) ---
# Pick ONE: "cohere" or "gemini". Set that provider's API key below.
AI_PROVIDER=cohere

# Cohere — get a key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-r-plus

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Retrieval (finding the right chunks of a report) always uses Cohere
# embeddings if COHERE_API_KEY is set, regardless of AI_PROVIDER, since
# it's materially better than the built-in local TF-IDF fallback used
# otherwise — no key required for that fallback.

# --- Shared folder both this service and the chatbot read/write ---
REPORTS_DIR=./reports
# Near-real-time polling — works everywhere, no extra setup. Can go as low
# as a few seconds; 30 is a sane floor to avoid hammering the mailbox API.
POLL_INTERVAL_SECONDS=600

# Optional: only pick up automated report emails, not everything with an attachment
REPORT_SENDER_FILTER=reports@yourcompany.com
REPORT_SUBJECT_FILTER=

# --- Real-time push (true instant notifications, needs a public URL) ---
# Google and Microsoft cannot send push notifications to localhost. Set
# this to a publicly reachable HTTPS URL — for local testing, run a tunnel
# (ngrok: `ngrok http 5000`, or Cloudflare Tunnel) and paste the URL it
# gives you. Leave blank to just rely on the polling above instead.
PUBLIC_BASE_URL=

# Random string that protects both webhook endpoints from being triggered
# by anyone who guesses the URL. Change this to your own value.
WEBHOOK_SHARED_SECRET=dev-secret-change-me

# --- Gmail ---
GMAIL_ENABLED=true
# "oauth" (default) needs credentials.json from Google Cloud Console.
# "imap" is quicker: just a Gmail address + App Password, no cloud project.
# NOTE: real-time push (below) only works with "oauth" — IMAP has no
# push equivalent, so it always uses the polling interval above.
GMAIL_AUTH_METHOD=oauth
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./gmail_token.json
# Only needed if GMAIL_AUTH_METHOD=imap
GMAIL_IMAP_ADDRESS=
GMAIL_IMAP_APP_PASSWORD=
# Only needed for Gmail real-time push — a Google Cloud Pub/Sub topic with
# Gmail's push service account granted Publish rights on it, and a push
# subscription pointing at {PUBLIC_BASE_URL}/api/webhooks/gmail. Full
# steps in backend/README.md.
GMAIL_PUBSUB_TOPIC=

# --- Outlook / Microsoft 365 ---
OUTLOOK_ENABLED=true
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_TENANT_ID=your-tenant-id-or-"common"
OUTLOOK_TOKEN_CACHE_PATH=./outlook_token_cache.json
# Outlook real-time push needs no extra cloud setup beyond the app
# registration above — the subscription is created automatically once
# PUBLIC_BASE_URL is set and you click "Enable Outlook Push" in Settings.

# --- API server ---
API_HOST=0.0.0.0
API_PORT=5000
# Comma-separated list of frontend origins allowed to call this API.
# Leave unset to use the default (localhost:5173 + localhost:5000 on
# both "localhost" and "127.0.0.1"), which covers the normal local-dev
# setup with zero config. Set to * only if you need something broader.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
